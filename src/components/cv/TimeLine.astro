---
const { title, start, end, organization, city, state, excludeVerticalBar } = Astro.props;
const dateRange = [start, end].filter(Boolean).join(' - ');
const location = [city, state].filter(Boolean).join(', ');
const experienceDataClasses = excludeVerticalBar ? 'pb-8' : 'pb-10 pl-5 sm:pl-7';
---

<article class="flex">
	{!!!excludeVerticalBar && (
		<div class="education__time flex w-4 shrink-0 flex-col items-center">
			<span class="timeline-dot mt-1 block h-3.5 w-3.5 shrink-0 rounded-full border-[3px] border-base-100 bg-primary ring-2 ring-primary/30" />
			<span class="education__line mt-2 block h-full w-px bg-gradient-to-b from-primary/60 to-primary/10" />
		</div>
	)}
	<div class={`experience__data ${experienceDataClasses}`}>
		<h3 class="text-xl font-bold tracking-tight sm:text-2xl">
			{title} <span class="font-medium text-base-content/55">at {organization}</span>
		</h3>
		{(dateRange || location) && (
			<div class="mt-2 flex flex-wrap gap-x-2 text-sm font-medium text-base-content/55">
				{dateRange && <span>{dateRange}</span>}
				{dateRange && location && ', '}
				{location && <span>{location}</span>}
			</div>
		)}
		<div class="resume-detail mt-5 leading-relaxed text-base-content/75">
			<slot />
		</div>
	</div>
</article>

<style>
	.resume-detail :global(ul) {
		margin: 0;
		padding-left: 1.15rem;
		gap: 0.7rem;
	}

	.resume-detail :global(li) {
		font-size: 1rem;
	}

	.resume-detail :global(li::marker) {
		color: var(--color-primary);
	}

	.resume-detail :global(em) {
		font-style: normal;
		font-weight: 650;
		color: var(--color-base-content);
	}

	.timeline-dot {
		animation: timeline-pulse 2.2s ease-out infinite;
	}

	@keyframes timeline-pulse {
		0%,
		45% {
			box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-primary) 45%, transparent);
		}
		80%,
		100% {
			box-shadow: 0 0 0 0.55rem transparent;
		}
	}
</style>
