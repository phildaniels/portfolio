---
const { title, img, desc, url, badge, tags, target = '_blank' } = Astro.props;
import { Image } from 'astro:assets';
---

<article class="surface-card interactive-card group overflow-hidden">
	<a
		href={url}
		target={target}
		rel={target === '_blank' ? 'noreferrer' : undefined}
		class="flex h-full flex-col sm:flex-row"
	>
		{img && (
			<div class="relative overflow-hidden sm:w-52 sm:shrink-0">
				<Image
					src={img}
					width={750}
					height={422}
					format="webp"
					alt=""
					class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-[1.035] sm:h-full"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent sm:bg-gradient-to-r" />
			</div>
		)}
		<div class="flex min-w-0 grow flex-col justify-center p-5 sm:p-6">
			<div class="mb-2 flex flex-wrap items-center gap-2">
				<h3 class="text-lg font-bold tracking-tight transition-colors group-hover:text-primary sm:text-xl">
					{title}
				</h3>
				{badge && <span class="badge badge-secondary badge-sm font-semibold">{badge}</span>}
				<span
					class="ml-auto text-base-content/35 transition-transform group-hover:translate-x-1"
					aria-hidden="true"
				>
					↗
				</span>
			</div>
			<p class="leading-relaxed text-base-content/68">{desc}</p>
			{tags && (
				<div class="mt-4 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<span class="badge badge-outline badge-sm">{tag}</span>
					))}
				</div>
			)}
		</div>
	</a>
</article>
