---
import { Image } from 'astro:assets';
import workflowsHome from '../assets/workflows-agent/home.png';

const projectUrl = '/projects/workflows-agent/';
const productUrl =
	'https://support.microsoft.com/en-us/microsoft-365-copilot/get-started-with-workflows-in-microsoft-365-copilot';
---

<article class="surface-card interactive-card relative overflow-hidden">
	<a
		href={projectUrl}
		class="absolute inset-0 z-10 rounded-[inherit]"
		aria-label="View the Workflows Agent project showcase"
	></a>

	<div class="pointer-events-none flex flex-col items-stretch lg:flex-row">
		<div class="relative min-h-72 w-full overflow-hidden border-b border-base-content/10 bg-[#191a22] lg:min-h-96 lg:w-[45%] lg:shrink-0 lg:border-b-0 lg:border-r">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,color-mix(in_oklab,var(--color-secondary)_20%,transparent),transparent_58%)]"></div>
			<Image
				src={workflowsHome}
				alt="Workflows Agent home in Microsoft 365 Copilot"
				class="absolute inset-0 h-full w-full object-cover object-left"
				width={1184}
				quality={82}
			/>
		</div>

		<div class="flex grow flex-col justify-center p-6 sm:p-8">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<h3 class="text-2xl font-bold tracking-tight">Workflows Agent</h3>
				<span class="badge badge-secondary badge-sm font-semibold">Microsoft product</span>
			</div>
			<p class="leading-relaxed text-base-content/75">
				An agent in Microsoft 365 Copilot that turns natural-language requests into working
				automations across Outlook, Teams, SharePoint, Planner, and more.
			</p>
			<p class="mt-3 text-sm leading-relaxed text-base-content/55">
				I improved agent quality by 15% through prompt engineering and systematic agent evaluations.
			</p>
			<div class="pointer-events-auto relative z-20 mt-5 flex flex-wrap gap-2">
				<a class="btn btn-primary btn-sm" href={projectUrl}>
					View showcase
				</a>
				<a class="btn btn-ghost btn-sm" href={productUrl} target="_blank" rel="noreferrer">
					Product guide ↗
				</a>
			</div>
			<div class="mt-5 flex flex-wrap gap-2">
				<span class="badge badge-outline badge-sm">Microsoft 365 Copilot</span>
				<span class="badge badge-outline badge-sm">AI agents</span>
				<span class="badge badge-outline badge-sm">Evaluations</span>
			</div>
		</div>
	</div>
</article>
