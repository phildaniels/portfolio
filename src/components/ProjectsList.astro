---
import ArgentumProject from './ArgentumProject.astro';
import HorizontalCard from './HorizontalCard.astro';
import LicensingReportProject from './LicensingReportProject.astro';
import TempusProject from './TempusProject.astro';
import WorkflowsProject from './WorkflowsProject.astro';
---

<div class="grid gap-5">
	<WorkflowsProject />
	<TempusProject />
	<LicensingReportProject />
	<ArgentumProject />
	<HorizontalCard
		title="VS Code Extension: Line Number Utils"
		img="/line_number_utils.webp"
		desc="Utilities for inserting and copying line numbers during single and multi-cursor editing."
		url="https://marketplace.visualstudio.com/items?itemName=PhilDanielsIO.vscode-line-number-utils"
		badge="FOSS"
		tags={['VS Code', 'Extension']}
	/>
	<HorizontalCard
		title="VS Code Extension: Retro Sunset Theme"
		img="/retro_sunset.webp"
		desc="A VS Code theme inspired by the vibrant retro sunsets of the 80s."
		url="https://marketplace.visualstudio.com/items?itemName=PhilDanielsIO.retro-sunset-theme"
		badge="FOSS"
		tags={['VS Code', 'Theme']}
	/>
</div>
