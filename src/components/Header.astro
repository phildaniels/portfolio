---
import ThemeIcon from './ThemeIcon.astro';
---

<header class="site-chrome sticky top-0 z-30 flex h-16 w-full border-b border-base-content/10 bg-base-100/85 text-base-content backdrop-blur-xl lg:hidden">
	<div class="navbar mx-auto max-w-3xl px-3">
		<div class="navbar-start">
			<label for="my-drawer" class="btn btn-square btn-ghost" aria-label="Open navigation">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					class="inline-block h-5 w-5 stroke-current"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"
					></path>
				</svg>
			</label>
		</div>
		<div class="navbar-center">
			<a class="text-sm font-bold tracking-tight sm:text-base" href="/">
				Phil Daniels
			</a>
		</div>
		<div class="navbar-end">
			<ThemeIcon />
		</div>
	</div>
</header>
