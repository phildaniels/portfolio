---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalCard from '../components/HorizontalCard.astro';
import ProjectsList from '../components/ProjectsList.astro';
import { getCollection } from 'astro:content';
import createSlug from '../lib/createSlug';

const collection = await getCollection('blog');
const posts = collection
	.filter((post) => post.data.pubDate < new Date())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);

const mailTo = 'mailto:' + 'phil' + '@' + 'danielsdev' + '.cloud';
---

<BaseLayout sideBarActiveItemID="home">
	<section class="reveal relative mb-20 overflow-hidden">
		<div class="mb-6 flex items-center gap-3">
			<span class="h-2.5 w-2.5 animate-pulse rounded-full bg-secondary"></span>
			<span class="text-sm font-medium text-base-content/60">
				Building thoughtful software remotely in Colorado
			</span>
		</div>
		<p class="eyebrow">Hello, I'm Phil</p>
		<h1 class="mt-5 max-w-4xl text-5xl font-extrabold leading-[1.04] tracking-[-0.055em] sm:text-6xl lg:text-7xl">
			Software Engineer shipping{' '}
			<span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
				delightful products to millions of people.
			</span>
		</h1>
		<p class="mt-8 max-w-3xl text-lg leading-8 text-base-content/68 sm:text-xl sm:leading-9">
			I'm a software engineer at <strong class="font-semibold text-base-content">Microsoft</strong>{' '}
			in Windsor, Colorado. I turn complex product and platform challenges into reliable,
			approachable experiences across frontend, backend, cloud, and AI systems.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a class="btn btn-primary px-6" href={mailTo}>
				Let's connect <span aria-hidden="true">↗</span>
			</a>
			<a class="btn btn-ghost border border-base-content/12 px-6" href="/projects">
				Explore my work
			</a>
		</div>
		<div class="mt-12 grid max-w-3xl gap-3 sm:grid-cols-3">
			<div class="rounded-xl border border-base-content/10 bg-base-200/50 p-4">
				<p class="text-2xl font-bold tracking-tight">9+ Years</p>
				<p class="mt-1 text-sm text-base-content/55">Shipping software at scale</p>
			</div>
			<div class="rounded-xl border border-base-content/10 bg-base-200/50 p-4">
				<p class="text-2xl font-bold tracking-tight">Cloud + AI</p>
				<p class="mt-1 text-sm text-base-content/55">
					Building intelligent products with frontier models
				</p>
			</div>
			<div class="rounded-xl border border-base-content/10 bg-base-200/50 p-4">
				<p class="whitespace-nowrap text-xl font-bold tracking-tight">AI-native engineering</p>
				<p class="mt-1 text-sm text-base-content/55">
					Using agents and automation to ship faster without sacrificing quality
				</p>
			</div>
		</div>
	</section>

	<section class="reveal reveal-delay-1 mb-20" aria-labelledby="projects-heading">
		<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
			<div>
				<p class="eyebrow">Selected work</p>
				<h2 id="projects-heading" class="section-heading mt-3">
					Projects built with curiosity
				</h2>
				<p class="section-copy mt-3">
					Open-source tools, experiments, and products I work on outside of work.
				</p>
			</div>
			<a
				class="link link-primary shrink-0 font-semibold no-underline hover:underline"
				href="/projects"
			>
				View all projects →
			</a>
		</div>
		<ProjectsList />
	</section>

	<section class="reveal reveal-delay-2" aria-labelledby="writing-heading">
		<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
			<div>
				<p class="eyebrow">Writing</p>
				<h2 id="writing-heading" class="section-heading mt-3">
					Latest from the blog
				</h2>
			</div>
			<a class="link link-primary shrink-0 font-semibold no-underline hover:underline" href="/blog">
				Browse all posts →
			</a>
		</div>

		<div class="grid gap-5">
			{last_posts.map((post) => (
				<HorizontalCard
					title={post.data.title}
					img={post.data.heroImage}
					desc={post.data.description}
					url={'/blog/' + createSlug(post.data.title, post.id)}
					target="_self"
					badge={post.data.badge}
				/>
			))}
		</div>
	</section>
</BaseLayout>
