---
import { type BlogSchema } from '../content.config';
import BaseLayout from './BaseLayout.astro';
import dayjs from 'dayjs';
import localizedFormat from 'dayjs/plugin/localizedFormat';

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format('ll');
import { Image } from 'astro:assets';
---

<BaseLayout title={title} description={description} ogType="article">
	<div class="flex min-w-0 justify-center">
		<article class="blog-post prose prose-lg prose-headings:tracking-tight prose-a:text-primary w-full min-w-0 max-w-[48rem] prose-img:mx-auto">
			<a href="/blog" class="mb-8 inline-flex text-sm font-semibold no-underline">
				← Back to writing
			</a>
			{heroImage && (
				<Image
					width={750}
					height={422}
					format="webp"
					src={heroImage}
					alt={title}
					class="mb-8 w-full rounded-2xl shadow-xl"
				/>
			)}
			<h1 class="title mb-4 mt-2 text-4xl font-extrabold tracking-[-0.04em] sm:text-5xl">
				{title}
			</h1>
			<div class="not-prose mb-8 flex flex-wrap items-center gap-2 text-sm text-base-content/55">
				{pubDate && <time datetime={pubDate.toISOString()}>{displayDate}</time>}
				{badge && <span class="badge badge-secondary badge-sm">{badge}</span>}
				{tags &&
					tags.map((tag) => (
						<a href={`/blog/tag/${tag}`} class="badge badge-outline badge-sm no-underline">
							{tag}
						</a>
					))}
				{updatedDate && (
					<span>
						Updated <time>{updatedDate}</time>
					</span>
				)}
			</div>
			<slot />
		</article>
	</div>
</BaseLayout>

<style>
	.blog-post {
		overflow-wrap: anywhere;
	}

	.blog-post :global(pre) {
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
	}

	.blog-post :global(pre code) {
		overflow-wrap: normal;
		word-break: normal;
	}

	.blog-post :global(:not(pre) > code),
	.blog-post :global(a) {
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.blog-post :global(img),
	.blog-post :global(video),
	.blog-post :global(iframe),
	.blog-post :global(table) {
		max-width: 100%;
	}

	.blog-post :global(table) {
		display: block;
		overflow-x: auto;
	}
</style>
