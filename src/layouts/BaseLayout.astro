---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideBar from '../components/SideBar.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../config';
import ThemeIcon from '@components/ThemeIcon.astro';

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	includeSidebar = true,
	sideBarActiveItemID,
	ogType
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={title} description={description} ogType={ogType} />
	</head>
	<body>
		<a
			href="#main-content"
			class="btn btn-primary btn-sm fixed left-4 top-3 z-[100] -translate-y-20 focus:translate-y-0"
		>
			Skip to content
		</a>
		<div class="drawer min-h-screen lg:drawer-open">
			<input id="my-drawer" type="checkbox" class="drawer-toggle" />
			<div class="drawer-content flex min-h-screen min-w-0 flex-col">
				<Header />
				<div class="site-chrome fixed right-4 top-3 z-50 hidden lg:block">
					<ThemeIcon />
				</div>
				<div class="flex grow justify-center">
					<main
						id="main-content"
						class="w-full max-w-[var(--page-max)] px-5 py-10 sm:px-8 sm:py-14 lg:px-12 lg:py-16"
					>
						<slot />
					</main>
				</div>
				<Footer />
			</div>
			{includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
		</div>
	</body>
</html>
